# Copier ce fichier en .env et renseigner les valeurs Supabase
# Settings → API dans le projet Supabase

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Intervalle de rafraîchissement en millisecondes (défaut : 60 000 = 1 min)
# Supabase Realtime gère les mises à jour live entre les refresh
VITE_REFRESH_INTERVAL=60000
