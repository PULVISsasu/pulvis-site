# Supabase — projet pulvis-backend-fr (schéma dédié fitness_intel)
NEXT_PUBLIC_SUPABASE_URL=https://zrktunxspbtjzaolulse.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role — SERVEUR UNIQUEMENT, jamais exposée au client. Utilisée
# par les routes API (app/api/**) pour écrire dans fitness_intel.*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Connecteurs (voir docs/fitness-intelligence-architecture.md §2) ---

# API Sirene INSEE — optionnel, dégrade proprement si absent (compte gratuit
# sur https://portail-api.insee.fr)
SIRENE_API_KEY=

# INPI RNE — optionnel, nécessite un compte https://data.inpi.fr
INPI_API_USER=
INPI_API_PASSWORD=

# Moteur de recherche autorisé pour le connecteur web-search (optionnel).
# Ex. Bing Web Search API, SerpAPI... Laisser vide pour désactiver.
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=
